# Copiar a backend/.env y completar. backend/.env NO se commitea.

# Generar una con:
#   .venv\Scripts\python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

DJANGO_DEBUG=True

# Integración interna de Notion (https://www.notion.so/profile/integrations).
# La base Destinations tiene que estar compartida con la integración (••• > Connections).
NOTION_TOKEN=
# ID de la base Destinations: los 32 caracteres hexadecimales de su URL.
NOTION_DATABASE_ID=
